mapscripts FortreeCity_House3_MapScripts {}

script FortreeCity_House3_EventScript_Maniac {
    msgbox(FortreeCity_House3_Text_MetStevenHadAmazingPokemon, MSGBOX_NPC)
    end
}

script FortreeCity_House3_EventScript_SchoolKidM {
	if (specialvar(VAR_RESULT, IsShelmetOrKarrablastInParty) == TRUE) {
		if (!flag(FLAG_RECEIVED_SHELMET_KARRABLAST)) {
			goto(FortreeCity_House3_EventScript_ReceiveBugMon)
		}
	}
    msgbox(FortreeCity_House3_Text_OhYouHavePokedex, MSGBOX_NPC)
    end
}

script FortreeCity_House3_EventScript_ReceiveBugMon {
	lock_faceplayer
	msgbox(FortreeCity_House3_Text_ThanksPleaseTakePokemon, MSGBOX_DEFAULT)
	bufferspeciesname(STR_VAR_1, VAR_0x8009)
	copyvar(VAR_TEMP_TRANSFERRED_SPECIES, VAR_0x8009)
	if (givemon(VAR_0x8009, 30) == MON_CANT_GIVE) {
		goto(Common_EventScript_NoMoreRoomForPokemon)
	}
	copyvar(VAR_0x8007, VAR_RESULT)
	playfanfare(MUS_OBTAIN_ITEM)
	message(FortreeCity_House3_Text_PlayerReceivedBugMon)
	waitmessage
	waitfanfare
	msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
	switch (var(VAR_RESULT)) {
		case MON_GIVEN_TO_PARTY:
			if (var(VAR_RESULT) == YES) {
				call(Common_EventScript_GetGiftMonPartySlot)
				call(Common_EventScript_NameReceivedPartyMon)
			}
		case MON_GIVEN_TO_PC:
			if (var(VAR_RESULT) == YES) {
				call(Common_EventScript_NameReceivedBoxMon)
			}
			call(Common_EventScript_TransferredToPC)
	}
	msgbox(FortreeCity_House3_Text_PokemonChangesWithWeather, MSGBOX_DEFAULT)
	setflag(FLAG_RECEIVED_SHELMET_KARRABLAST)
	release_end
}

text FortreeCity_House3_Text_MetStevenHadAmazingPokemon {
	"While speaking about POKéDEXES,
	I remembered something.

	I met this TRAINER, STEVEN, when
	I was searching for rare stones.

	Hoo, boy, he had some amazing POKéMON
	with him.

	They weren't just rare, they were
	trained to terrifying extremes!

	He might even be stronger than the
	GYM LEADER in this town…"
}

text FortreeCity_House3_Text_OhYouHavePokedex {
	"What's that thing you have there?

	… … … … … …

	Oh, it's called a POKéDEX?
	It's really awesome!"
}

text FortreeCity_House3_Text_ThanksPleaseTakePokemon {
	"Thanks!
	Thanks to you, we're safe!

	It might be an odd way of thanking you,
	but take this POKéMON."
}

text FortreeCity_House3_Text_PlayerReceivedBugMon {
	"{PLAYER} received {STR_VAR_1}!"
}

text FortreeCity_House3_Text_PokemonChangesWithWeather {
	"That POKéMON changes shape according
	to the weather conditions.

	There're plenty of them in the
	INSTITUTE--go ahead and take it."
}
