script RusturfTunnel_EventScript_AquaGruntBackUp {
    lockall
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox(RusturfTunnel_Text_ComeAndGetSome, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_right * 8))
    waitmovement(0)
    delay(30)
    msgbox(RusturfTunnel_Text_WeakWoman, MSGBOX_DEFAULT)
    clearflag(FLAG_HIDE_RUSTURF_TUNNEL_HOUNDOUR)
    addobject(LOCALID_RUSTURF_HOUNDOUR)
    playse(SE_BALL_OPEN)
    applymovement(LOCALID_RUSTURF_HOUNDOUR, moves(exit_pokeball))
    waitmovement(0)
    playmoncry(SPECIES_HOUNDOUR, CRY_MODE_NORMAL)
    msgbox(RusturfTunnel_Text_HandThemOver, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_RUSTURF_HOUNDOUR, Common_Movement_RunRight)
    playse(SE_M_BITE)
    waitse
    playse(SE_M_BITE)
    msgbox(RusturfTunnel_Text_NowLetsSee, MSGBOX_DEFAULT)
    playse(SE_BALL_OPEN)
    applymovement(LOCALID_RUSTURF_HOUNDOUR, moves(enter_pokeball))
    waitmovement(0)
    removeobject(LOCALID_RUSTURF_HOUNDOUR)
    delay(30)
    applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, moves(walk_down, walk_right * 3, step_up))
    waitmovement(0)
    applymovement(LOCALID_RUSTURF_AQUA_GRUNT, Common_Movement_StepDown)
    msgbox(RusturfTunnel_Text_DontTouchMe, MSGBOX_DEFAULT)
    setvar(VAR_RUSTURF_TUNNEL_STATE, 3)
    releaseall
    end
}

script RusturfTunnel_EventScript_AquaGrunt {
    lock_faceplayer
    msgbox("Wha\. this brat, again?
            Stay out of this\.", MSGBOX_DEFAULT)
    applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, moves(walk_left, step_up))
    waitmovement(0)
    setvar(VAR_0x8003, 1)
    goto(RusturfTunnel_EventScript_MagmaGruntEncounter)
    end
}

script RusturfTunnel_EventScript_MagmaGrunt {
    lock_faceplayer
    setvar(VAR_0x8003, 0)
    goto(RusturfTunnel_EventScript_MagmaGruntEncounter)
    end
}

script RusturfTunnel_EventScript_MagmaGruntEncounter {
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    applymovement(LOCALID_PLAYER, moves(lock_look, run_left * 2))
    if (var(VAR_0x8003) == 1) {
        applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, moves(run_up, run_left))
    } else {
        applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, moves(run_left * 2))
    }
    if (checkplayergender == MALE) {
        msgbox(RusturfTunnel_Text_GruntIntroMale, MSGBOX_DEFAULT)
    } else {
        msgbox(RusturfTunnel_Text_GruntIntroFemale, MSGBOX_DEFAULT)
    }
    trainerbattle_no_intro(TRAINER_GRUNT_RUSTURF_TUNNEL, RusturfTunnel_Text_GruntDefeat)
    if (checkplayergender == MALE) {
        msgbox(RusturfTunnel_Text_AfterBattleMale, MSGBOX_DEFAULT)
    } else {
        msgbox(RusturfTunnel_Text_AfterBattleFemale, MSGBOX_DEFAULT)
    }
    applymovement(LOCALID_PLAYER, moves(lock_look, creep_left * 2))
    waitmovement(0)
    applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, Common_Movement_WalkLeft)
    waitmovement(0)
    if (var(VAR_0x8003) == 1) {
        applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(run_down, run_left * 3, step_faster_up))
    } else {
        applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(run_left * 3, step_faster_down))
    }
    waitmovement(0)
    playse(SE_M_COMET_PUNCH)
    if (var(VAR_0x8003) == 1) {
        applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, Common_Movement_StepFasterDown)
    } else {
        applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, Common_Movement_StepFasterUp)
    }
    waitmovement(0)
    msgbox(RusturfTunnel_Text_Punch, MSGBOX_DEFAULT)
    closemessage
    if (var(VAR_0x8003) == 1) {
        applymovement(LOCALID_PLAYER, moves(face_up,  lock_look,  walk_down,  unlock_look,  step_faster_left))
    } else {
        applymovement(LOCALID_PLAYER, moves(face_down,  lock_look,  walk_up,  unlock_look,  step_faster_left))
    }
    applymovement(LOCALID_RUSTURF_MAGMA_GRUNT, moves(run_left * 9))
    waitmovement(0)
    removeobject(LOCALID_RUSTURF_MAGMA_GRUNT)
    delay(50)
    applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(walk_left, step_left))
    applymovement(LOCALID_PLAYER, Common_Movement_StepRight)
    waitmovement(0)
    msgbox(RusturfTunnel_Text_GiveParts, MSGBOX_DEFAULT)
    giveitem(ITEM_DEVON_PARTS)
    closemessage
    if (var(VAR_0x8003) == 1) {
        applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(walk_up, walk_left * 4, delay_16 * 4, step_right))
    } else {
        applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(walk_down, walk_left * 4, delay_16 * 4, step_right))
    }
    applymovement(LOCALID_PLAYER, moves(delay_16 * 3, step_left))
    waitmovement(LOCALID_RUSTURF_AQUA_GRUNT)
    msgbox(RusturfTunnel_Text_MyNameIs, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(step_left, walk_left * 5))
    waitmovement(0)
    removeobject(LOCALID_RUSTURF_AQUA_GRUNT)
    delay(50)
    clearflag(FLAG_DEVON_GOODS_STOLEN)
    setflag(FLAG_RECOVERED_DEVON_GOODS)
    if (var(VAR_REGISTER_BIRCH_STATE) == 0) {
        setvar(VAR_REGISTER_BIRCH_STATE, 1)
    }
    setvar(VAR_RUSTBORO_CITY_STATE, 4)
    setvar(VAR_BRINEY_HOUSE_STATE, 1)
    release_end
}

script RusturfTunnel_EventScript_Peeko {
    lock_faceplayer
    waitse
    playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
    msgbox(RusturfTunnel_Text_Peeko, MSGBOX_DEFAULT)
    waitmoncry
    release_end
}

script RusturfTunnel_EventScript_Grunt {
    lock_faceplayer
    playbgm(MUS_ENCOUNTER_AQUA, FALSE)
    msgbox(RusturfTunnel_Text_GruntIntro_Old, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_GRUNT_RUSTURF_TUNNEL, RusturfTunnel_Text_GruntDefeat)
    msgbox(RusturfTunnel_Text_GruntTakePackage, MSGBOX_DEFAULT)
    giveitem(ITEM_DEVON_PARTS)
    closemessage
    applymovement(LOCALID_PLAYER, moves(face_down,  lock_look,  walk_up,  unlock_look,  step_faster_left))
    applymovement(LOCALID_RUSTURF_AQUA_GRUNT, moves(run_left * 9))
    waitmovement(0)
    removeobject(LOCALID_RUSTURF_AQUA_GRUNT)
    delay(50)
    addobject(LOCALID_RUSTURF_TUNNEL_BRINEY)
    applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves(walk_right * 7))
    waitmovement(0)
    applymovement(LOCALID_PLAYER, moves(walk_down,  step_faster_up))
    applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves(delay_16,  walk_right))
    waitmovement(0)
    msgbox(RusturfTunnel_Text_PeekoGladToSeeYouSafe, MSGBOX_DEFAULT)
    applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, Common_Movement_FacePlayer)
    waitmovement(0)
    message(RusturfTunnel_Text_ThankYouLetsGoHomePeeko)
    waitmessage
    waitse
    playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
    waitbuttonpress
    waitmoncry
    closemessage
    applymovement(LOCALID_PLAYER, moves(delay_16,  delay_8,  delay_4,  step_faster_left))
    applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves(walk_left * 11))
    applymovement(LOCALID_RUSTURF_TUNNEL_PEEKO, moves(walk_left * 9))
    waitmovement(0)
    removeobject(LOCALID_RUSTURF_TUNNEL_BRINEY)
    removeobject(LOCALID_RUSTURF_TUNNEL_PEEKO)
    clearflag(FLAG_DEVON_GOODS_STOLEN)
    setflag(FLAG_RECOVERED_DEVON_GOODS)
    if (var(VAR_REGISTER_BIRCH_STATE) == 0) {
        setvar(VAR_REGISTER_BIRCH_STATE, 1)
    }
    setvar(VAR_RUSTBORO_CITY_STATE, 4)
    setvar(VAR_BRINEY_HOUSE_STATE, 1)
    release_end
}

script RusturfTunnel_EventScript_Mike {
    trainerbattle_single(TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat)
    msgbox(RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE)
    end
}

text RusturfTunnel_Text_ComeAndGetSome {
	"{SPEAKER NAME_UNKNOWN}Stay away from me, freak!
	Come any closer and you'll regret it!"
}

text RusturfTunnel_Text_WeakWoman {
    "{SPEAKER NAME_MAGMA_GRUNT}You should only make threats you can 
    keep, AQUA trash.
    
    Why would TEAM AQUA send a woman to do
    a man's job?

    It's only natural you and your POK\eMON 
    would be weak.
    
    {SPEAKER NAME_AQUA_GRUNT}Say that again and I'll cram my fist 
    down your throat, you creep!

    {SPEAKER NAME_MAGMA_GRUNT}Hahahahaha! That's cute."
}

text RusturfTunnel_Text_HandThemOver {
    "{SPEAKER NAME_MAGMA_GRUNT}Now, hand over the goods before I do 
    something we'll both regret!

    {SPEAKER NAME_AQUA_GRUNT}Do your worst, you pansy!
    I'm not giving you squat!

    {SPEAKER NAME_MAGMA_GRUNT}Suit yourself, girlie."
}

text RusturfTunnel_Text_NowLetsSee {
    "{SPEAKER NAME_AQUA_GRUNT}AHHHGGHH! You piece of trash!
    Ahhhgh, damn it\.

    {SPEAKER NAME_MAGMA_GRUNT}Why do girls always make things hard?
    
    You couldn't bring yourself to give up.
    Now, look where it's gotten you."
}

text RusturfTunnel_Text_DontTouchMe {
    "{SPEAKER NAME_AQUA_GRUNT}Don't touch me, you creep!
    Ah, owww\.

    {SPEAKER NAME_MAGMA_GRUNT}Well, what might this be?

    {SPEAKER NAME_AQUA_GRUNT}No, please! I can't let you take that!"
}

text RusturfTunnel_Text_Punch {
    "{SPEAKER NAME_MAGMA_GRUNT}OWW! You sucker-punched me, you hag!
    
    {SPEAKER NAME_AQUA_GRUNT}Give me back those parts! NOW!
    Before I give you another thing to
    cry about!
    
    {SPEAKER NAME_MAGMA_GRUNT}Psssh, fine\. 
    but I won't forget this.
    
    I'll make sure my powerful friends know 
    who you are, and they'll make you wish
    you were never born.
    
    {SPEAKER NAME_AQUA_GRUNT}GET LOST, YOU COWARD!
    
    {SPEAKER NAME_MAGMA_GRUNT}Hmmph!"
}

text RusturfTunnel_Text_GiveParts {
    "{SPEAKER NAME_AQUA_GRUNT}Don't say a word.
    
    I'm giving you these back to settle my 
    debt, but don't get the wrong idea.
    This doesn't change a thing."
}

text RusturfTunnel_Text_MyNameIs {
    "{SPEAKER NAME_AQUA_GRUNT}My name is Steph, by the way\.

    Now, stay out of my way."
}

text RusturfTunnel_Text_Peeko {
	"{SPEAKER NAME_PEEKO}Pii pihyoh!"
}

text RusturfTunnel_Text_GruntIntro_Old {
	"Grah, keelhaul it all!

	That hostage POKéMON turned out to
	be worthless!

	And to think I made a getaway…
	In this tunnel to nowhere!

	Hey! You!
	So you want to battle me?"
}

text RusturfTunnel_Text_GruntIntroMale {
	"Well, what are you, kid? 
    Her knight in shining armor?
    
    You picked the wrong guy to mess with.
    I'll crush you just like I did her!"
}

text RusturfTunnel_Text_GruntIntroFemale {
	"Well, well, another girl trying to
    get in my way?
    
    This day just gets better and better.
    
    I should make quicker work of you than
    I did this weakling."
}

text RusturfTunnel_Text_GruntDefeat {
	"Urrrggh! How could I lose to some brat!?"
}

text RusturfTunnel_Text_GruntTakePackage {
	"This is plain not right…

	The BOSS told me this would be a
	slick-and-easy job to pull.

	All I had to do was steal some package
	from DEVON.

	Tch!
	You want it back that badly, take it!"
}

text RusturfTunnel_Text_AfterBattleMale {
	"How is some barely pubescent brat this
    strong!?

    This has to be some kind of trick.
    Who put you up to this, huh?!"
}

text RusturfTunnel_Text_AfterBattleFemale {
	"I was beaten by a damn girl!?
    This has to be some kind of trick!

    Who put you up to this, huh?!"
}

text RusturfTunnel_Text_PeekoGladToSeeYouSafe {
	"PEEKO!
	Am I glad to see you're safe!"
}

text RusturfTunnel_Text_ThankYouLetsGoHomePeeko {
	"PEEKO owes her life to you!

	They call me MR. BRINEY.
	And, you are?

	… … … … … … … …
	… … … … … … … …

	Ah, so you are {PLAYER}{KUN}!
	I sincerely thank you!

	Now, if there's anything that troubles
	you, don't hesitate to tell me!

	You can usually find me in my cottage
	by the sea near PETALBURG WOODS.

	Come, PEEKO, we should make our way
	home.

	{SPEAKER NAME_PEEKO}Pihyoh!"
}

text RusturfTunnel_Text_WhyCantTheyKeepDigging {
	"… …

	Why can't they keep digging?
	Is the bedrock too hard?

	My beloved awaits me in VERDANTURF
	TOWN just beyond here…

	If RUSTBORO and VERDANTURF were
	joined by this tunnel, I could visit
	her every day…

	But this…
	What am I to do?"
}

text RusturfTunnel_Text_ToGetToVerdanturf {
	"To get from RUSTBORO to VERDANTURF,
	you need to go to DEWFORD, then pass
	through SLATEPORT and MAUVILLE…"
}

text RusturfTunnel_Text_YouShatteredBoulderTakeHM {
	"Wow! You shattered that boulder
	blocking the way.

	To show you how much I appreciate it,
	I'd like you to have this HM."
}

text RusturfTunnel_Text_ExplainStrength {
	"That HM contains STRENGTH.

	If a muscular POKéMON were to learn
	that, it would be able to move even
	large boulders."
}

text RusturfTunnel_Text_WandaReunion {
	"WANDA!
	Now I can see you anytime!

	{SPEAKER NAME_WANDA}That's…wonderful.

	Please, take some rest at my home."
}

text RusturfTunnel_Text_BoyfriendOnOtherSideOfRock {
	"On the other side of this rock…
	My boyfriend is there.

	He… He's not just digging the tunnel
	to come see me.

	He works his hands raw and rough
	for the benefit of everyone."
}

text RusturfTunnel_Text_MikeIntro {
	"What do you call a wild man up in the
	mountains? A mountain man, right?

	So why don't they call a POKéMON in
	the mountains a mountain POKéMON?"
}

text RusturfTunnel_Text_MikeDefeat {
	"My POKéMON…
	Ran out of power…"
}

text RusturfTunnel_Text_MikePostBattle {
	"They halted development here to
	protect POKéMON, right?
	There's a feel-good story!"
}
