mapscripts LavaridgeTown_HerbShop_MapScripts {}

script LavaridgeTown_HerbShop_EventScript_Clerk {
    lock_faceplayer
    message(LavaridgeTown_HerbShop_Text_WelcomeToHerbShop)
    waitmessage
    pokemart(LavaridgeTown_HerbShop_Pokemart)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release_end
}

mart LavaridgeTown_HerbShop_Pokemart {
    ITEM_HEAL_POWDER
    ITEM_ENERGY_POWDER
    ITEM_ENERGY_ROOT
    ITEM_REVIVAL_HERB
}

script LavaridgeTown_HerbShop_EventScript_ExpertM {
    msgbox(LavaridgeTown_HerbShop_Text_HerbalMedicineWorksButMonWillDislike, MSGBOX_NPC)
    end
}

script LavaridgeTown_HerbShop_EventScript_OldMan {
    lock_faceplayer
    if (flag(FLAG_RECEIVED_CHARCOAL)) {
        msgbox(LavaridgeTown_HerbShop_Text_ExplainCharcoal, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(LavaridgeTown_HerbShop_Text_YouveComeToLookAtHerbalMedicine, MSGBOX_DEFAULT)
    if (giveitem(ITEM_CLEANSE_TAG) == FALSE) {
		goto(Common_EventScript_ShowBagIsFull)
	}
    setflag(FLAG_RECEIVED_CHARCOAL)
    release_end
}

script LavaridgeTown_HerbShop_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_LAVARIDGE_WHIP_TUTOR)) {
		msgbox("\.", MSGBOX_DEFAULT)
		setflag(FLAG_MET_LAVARIDGE_WHIP_TUTOR)
	}
	msgbox("\.", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_WHIP_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(LavaridgeTown_HerbShop_EventScript_ChooseWhipMove)
	end
}

script LavaridgeTown_HerbShop_EventScript_ChooseWhipMove {
	setvar(VAR_0x8004, SCROLL_MULTI_WHIP_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_WATER_WHIP)
		case 1: setvar(VAR_0x8005, MOVE_FIRE_LASH)
		case 2: setvar(VAR_0x8005, MOVE_LASH_OUT)
		case 3: setvar(VAR_0x8005, MOVE_POWER_WHIP)
		case 4:
		case MULTI_B_PRESSED:
			goto(LavaridgeTown_HerbShop_EventScript_ExitTutorMoveSelect)
	}
	goto(LavaridgeTown_HerbShop_EventScript_ConfirmMoveSelection)
	end
}

script LavaridgeTown_HerbShop_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(LavaridgeTown_HerbShop_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script LavaridgeTown_HerbShop_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	msgbox("\.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("\.")
        waitmessage
        setvar(VAR_0x8006, 1)
        goto(LavaridgeTown_HerbShop_EventScript_ChooseWhipMove)
	}
	if (checkitem(ITEM_PEARL) == TRUE) {
		msgbox("\.", MSGBOX_DEFAULT)
        fadescreen(FADE_TO_BLACK)
        special(CloseBattleFrontierTutorWindow)
        chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
        waitstate
        if (var(VAR_RESULT) == FALSE) {
            msgbox(LavaridgeTown_HerbShop_Text_DeclineTutor, MSGBOX_DEFAULT)
            release_end
        }
        msgbox("\.", MSGBOX_DEFAULT)
        removeitem(ITEM_PEARL, 1)
        release_end
	}
	msgbox("\.", MSGBOX_DEFAULT)
	goto(LavaridgeTown_HerbShop_EventScript_ExitTutorMoveSelect)
	end
}

text LavaridgeTown_HerbShop_Text_DeclineTutor {
	"\."
}

text LavaridgeTown_HerbShop_Text_WelcomeToHerbShop {
	"Welcome to the HERB SHOP, home of
	effective and inexpensive medicine!"
}

text LavaridgeTown_HerbShop_Text_YouveComeToLookAtHerbalMedicine {
	"You've come to look at herbal medicine
	in LAVARIDGE?

	That's rather commendable.

	I like you! Take this!"
}

text LavaridgeTown_HerbShop_Text_ExplainCharcoal {
	"That CHARCOAL I gave you, it's used
	for making herbal medicine.

	It also does wonders when held by
	a POKéMON.

	It intensifies the power of FIRE-type
	moves."
}

text LavaridgeTown_HerbShop_Text_HerbalMedicineWorksButMonWillDislike {
	"Herbal medicine works impressively well.
	But your POKéMON will dislike you for it.
	It must be horribly bitter!"
}

text LavaridgeTown_HerbShop_Text_WaterWhipDesc {
	"A Water-type lash\n"
	"that will always\n"
	"cause flinching."
}

text LavaridgeTown_HerbShop_Text_FireLashDesc {
	"A Fire-type lash\n"
	"that will always\n"
	"cause flinching."
}

text LavaridgeTown_HerbShop_Text_LashOutDesc {
	"A Dark-type lash\n"
	"that is stronger\n"
	"at low HP."
}

text LavaridgeTown_HerbShop_Text_PowerWhipDesc {
	"A powerful lash\n"
	"of a vine that\n"
	"exhausts user."
}
