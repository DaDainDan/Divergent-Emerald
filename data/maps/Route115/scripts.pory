text Route115_Text_NeverKnowWhenCavePokemonWillAppear {
	"Be sure to use that TM a lot!

	Staying hydrated is important for
	people and POKéMON!"
}

text Route115_Text_RouteSignRustboro {
	"ROUTE 115
	{DOWN_ARROW} RUSTBORO CITY"
}

text Route115_Text_MeteorFallsSign {
	"METEOR FALLS
	FALLARBOR TOWN THROUGH HERE"
}

text Route115_Text_KeepYourPokemonHealthy {
	"Water is the source of life.

	Certain POKéMON can use it to restore
	their health and fortitude.

	You can teach them how with this
	technical machine."
}
