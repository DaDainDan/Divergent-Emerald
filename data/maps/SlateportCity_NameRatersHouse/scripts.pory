mapscripts SlateportCity_NameRatersHouse_MapScripts {}

script SlateportCity_NameRatersHouse_EventScript_NameRater {
    lock_faceplayer
    msgbox(SlateportCity_NameRatersHouse_Text_PleasedToRateMonNickname, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox(SlateportCity_NameRatersHouse_Text_CritiqueWhichMonNickname, MSGBOX_DEFAULT)
		chooseboxmon
		waitstate
		if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
			goto(SlateportCity_NameRatersHouse_EventScript_RateMonNickname)
		}
    }
    goto(SlateportCity_NameRatersHouse_EventScript_DeclineNameRate)
    end
}

script SlateportCity_NameRatersHouse_EventScript_DeclineNameRate {
    msgbox(SlateportCity_NameRatersHouse_Text_DoVisitAgain, MSGBOX_DEFAULT)
    release_end
}

script SlateportCity_NameRatersHouse_EventScript_RateMonNickname {
    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
    if (var(VAR_RESULT) == SPECIES_EGG) {
        msgbox(SlateportCity_NameRatersHouse_Text_ThatIsMerelyAnEgg, MSGBOX_DEFAULT)
    	release_end
    }
    special(BufferMonNickname)
    special(IsMonOTIDNotPlayers)
    if (var(VAR_RESULT) == TRUE) {
        goto(SlateportCity_NameRatersHouse_EventScript_PlayerNotMonsOT)
    }
    specialvar(VAR_RESULT, MonOTNameNotPlayer)
    special(BufferMonNickname)
    if (var(VAR_RESULT) == TRUE) {
        goto(SlateportCity_NameRatersHouse_EventScript_PlayerNotMonsOT)
    }
    msgbox(SlateportCity_NameRatersHouse_Text_FineNameSuggestBetterOne, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(SlateportCity_NameRatersHouse_EventScript_ChangeNickname)
    } else {
        goto(SlateportCity_NameRatersHouse_EventScript_DeclineNameRate)
    }
    end
}

script SlateportCity_NameRatersHouse_EventScript_PlayerNotMonsOT {
    msgbox(SlateportCity_NameRatersHouse_Text_MagnificentName, MSGBOX_DEFAULT)
    release_end
}

script SlateportCity_NameRatersHouse_EventScript_ChangeNickname {
    msgbox(SlateportCity_NameRatersHouse_Text_WhatShallNewNameBe, MSGBOX_DEFAULT)
    call(Common_EventScript_NameReceivedPartyMon)
    specialvar(VAR_RESULT, TryPutNameRaterShowOnTheAir)
    special(BufferMonNickname)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(SlateportCity_NameRatersHouse_Text_MonShallBeKnownAsName, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(SlateportCity_NameRatersHouse_Text_NameNoDifferentYetSuperior, MSGBOX_DEFAULT)
    release_end
}

script SlateportCity_NameRatersHouse_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_SLATEPORT_SWAP_TUTOR)) {
		msgbox(SlateportCity_NameRatersHouse_Text_SwapMasterIntro, MSGBOX_DEFAULT)
		setflag(FLAG_MET_SLATEPORT_SWAP_TUTOR)
	}
	msgbox(SlateportCity_NameRatersHouse_Text_ReadyToLearn, MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_SWAP_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(SlateportCity_NameRatersHouse_EventScript_ChooseSwapMove)
	end
}

script SlateportCity_NameRatersHouse_EventScript_ChooseSwapMove {
	setvar(VAR_0x8004, SCROLL_MULTI_SWAP_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_SKILL_SWAP)
		case 1: setvar(VAR_0x8005, MOVE_POWER_SWAP)
		case 2: setvar(VAR_0x8005, MOVE_GUARD_SWAP)
		case 3: setvar(VAR_0x8005, MOVE_SPEED_SWAP)
		case 4: setvar(VAR_0x8005, MOVE_POWER_TRICK)
		case 5:
		case MULTI_B_PRESSED:
			goto(SlateportCity_NameRatersHouse_EventScript_ExitTutorMoveSelect)
	}
	goto(SlateportCity_NameRatersHouse_EventScript_ConfirmMoveSelection)
	end
}

script SlateportCity_NameRatersHouse_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(SlateportCity_NameRatersHouse_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script SlateportCity_NameRatersHouse_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	msgbox(SlateportCity_NameRatersHouse_Text_MustHaveScales, MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("Take another gander.
			 I promise I won't pander.")
        waitmessage
        setvar(VAR_0x8006, 1)
        goto(SlateportCity_NameRatersHouse_EventScript_ChooseSwapMove)
	}
	if (checkitem(ITEM_HEART_SCALE) == TRUE) {
		msgbox("Pick one of six, then.
			Which one will it be?", MSGBOX_DEFAULT)
        fadescreen(FADE_TO_BLACK)
        special(CloseBattleFrontierTutorWindow)
        chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
        if (var(VAR_RESULT) == FALSE) {
            msgbox(SlateportCity_NameRatersHouse_Text_DeclineTutor, MSGBOX_DEFAULT)
            release_end
        }
        msgbox("Your HEART is now mine.
                Bring me more, unless you're a bore.", MSGBOX_DEFAULT)
        removeitem(ITEM_HEART_SCALE, 1)
        release_end
	}
	msgbox(SlateportCity_NameRatersHouse_Text_AreYouHeartless, MSGBOX_DEFAULT)
	goto(SlateportCity_NameRatersHouse_EventScript_ExitTutorMoveSelect)
	end
}

text SlateportCity_NameRatersHouse_Text_SwapMasterIntro {
    "Oh! Who are you?

	Are you even a \qoyou\qc?
	Or are you a \qothey\qc?

	How about a \qome\qc?

	I'm fine, thanks.
	Or maybe I'm not.

	If I open my mind, I can be anything
	and everything, you see.
			
	If you give me your HEART,
	I can make YOU just like ME!"
}

text SlateportCity_NameRatersHouse_Text_ReadyToLearn {
    "Ready to learn my shapeshifting ways?
				
	I'm ready when thou art.

	Which power would you like me to impart,
	in part?"
}

text SlateportCity_NameRatersHouse_Text_MustHaveScales {
    "To be a shapeshifter, you must have
	SCALES like a lizard.
			
	Remember when I asked you to open your
	HEART, miss-ter?
			
	Well, do you have the supply, small fry?"
}

text SlateportCity_NameRatersHouse_Text_AreYouHeartless {
    "Are truly HEARTless or maybe you 
	just hate me?
	
	Perhaps it's because you\. 
	ain't\. me."
}

text SlateportCity_NameRatersHouse_Text_DeclineTutor {
	"Is there no desire to be different
	in \qothere\qc?

	Please care. 
	Your lack of humanity gives me a scare."
}

text SlateportCity_NameRatersHouse_Text_PleasedToRateMonNickname {
	"Hi, hi! I'm the NAME RATER!
	I'm the fortune-teller of names!

	I shall be pleased to rate your
	POKéMON's nickname."
}

text SlateportCity_NameRatersHouse_Text_CritiqueWhichMonNickname {
	"Which POKéMON's nickname should
	I critique?"
}

text SlateportCity_NameRatersHouse_Text_FineNameSuggestBetterOne {
	"Hmmm… {STR_VAR_1}, is it? That is
	quite a fine name you bestowed.

	But! What say you, if I were to
	suggest a slightly better name?"
}

text SlateportCity_NameRatersHouse_Text_WhatShallNewNameBe {
	"Ah, good. Then, what shall the new
	nickname be?"
}

text SlateportCity_NameRatersHouse_Text_MonShallBeKnownAsName {
	"Done! From now on, this POKéMON
	shall be known as {STR_VAR_1}!

	It is a better name than before!
	How fortunate for you!"
}

text SlateportCity_NameRatersHouse_Text_DoVisitAgain {
	"I see.
	Do come visit again."
}

text SlateportCity_NameRatersHouse_Text_NameNoDifferentYetSuperior {
	"Done! From now on, this POKéMON
	shall be known as {STR_VAR_1}!

	It looks no different from before,
	and yet, this is vastly superior!

	How fortunate for you!"
}

text SlateportCity_NameRatersHouse_Text_MagnificentName {
	"Hmmm… {STR_VAR_1} it is!

	This is a magnificent nickname!
	It is impeccably beyond reproach!

	You'll do well to cherish your
	{STR_VAR_1} now and beyond."
}

text SlateportCity_NameRatersHouse_Text_ThatIsMerelyAnEgg {
	"Now, now.
	That is merely an EGG!"
}

text SlateportCity_NameRatersHouse_Text_SkillSwapDesc {
	"A technique that\n"
	"swaps abilities\n"
	"with the target."
}

text SlateportCity_NameRatersHouse_Text_PowerSwapDesc {
	"A technique that\n"
	"swaps Atk stats\n"
	"with the target."
}

text SlateportCity_NameRatersHouse_Text_GuardSwapDesc {
	"A technique that\n"
	"swaps Def stats\n"
	"with the target."
}

text SlateportCity_NameRatersHouse_Text_SpeedSwapDesc {
	"A technique that\n"
	"swaps Speed stats\n"
	"with the target."
}

text SlateportCity_NameRatersHouse_Text_PowerTrickDesc {
	"A technique that\n"
	"swaps the user's\n"
	"Atks and Defs."
}
