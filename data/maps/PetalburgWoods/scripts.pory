mapscripts PetalburgWoods_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
		if (var(VAR_TEMP_0) < 31) {
			call(PetalburgWoods_WildSet1Trigger)
		} else {
			call(PetalburgWoods_WildSet2Trigger)
		}
		end
    }
}

script PetalburgWoods_WildSet1Trigger {
    setvar(VAR_PETALBURG_WOODS_WILD_SET, 0)
    return
}

script PetalburgWoods_WildSet2Trigger {
    setvar(VAR_PETALBURG_WOODS_WILD_SET, 1)
    return
}

script PetalburgWoods_EventScript_DevonResearcherLeft {
    lockall
    call(PetalburgWoods_EventScript_DevonResearcherIntro)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(delay_16,  face_player,  walk_down * 2))
    waitmovement(0)
    call(PetalburgWoods_EventScript_DevonResearcherAquaEnters)
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, moves(run_down * 2))
    waitmovement(0)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, Common_Movement_StepFasterUp)
    waitmovement(0)
    msgbox(PetalburgWoods_Text_HandOverThosePapers, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(run_right,  run_down * 2,  run_left,  step_faster_up))
    waitmovement(0)
    msgbox(PetalburgWoods_Text_YouHaveToHelpMe, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, Common_Movement_WalkDown)
    waitmovement(0)
    call(PetalburgWoods_EventScript_DevonResearcherAquaBattleAndFinish)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(run_right,  run_up * 7))
    waitmovement(0)
    goto(PetalburgWoods_EventScript_RemoveDevonResearcher)
    end
}

script PetalburgWoods_EventScript_DevonResearcherRight {
    lockall
    call(PetalburgWoods_EventScript_DevonResearcherIntro)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(delay_16,  face_player,  walk_down * 3,  step_faster_right))
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_StepFasterLeft)
    waitmovement(0)
    call(PetalburgWoods_EventScript_DevonResearcherAquaEnters)
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, moves(run_down * 3))
    waitmovement(0)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, Common_Movement_StepFasterUp)
    waitmovement(0)
    msgbox(PetalburgWoods_Text_HandOverThosePapers, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(run_down,  run_right,  step_faster_up))
    waitmovement(0)
    msgbox(PetalburgWoods_Text_YouHaveToHelpMe, MSGBOX_DEFAULT)
    applymovement(LOCALID_PLAYER, Common_Movement_StepFasterUp)
    waitmovement(0)
	call(PetalburgWoods_EventScript_DevonResearcherAquaBattleAndFinish)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(run_left,  run_up * 7))
    waitmovement(0)
    goto(PetalburgWoods_EventScript_RemoveDevonResearcher)
    end
}

script PetalburgWoods_EventScript_DevonResearcherIntro {
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, PetalburgWoods_Movement_DevonResearcherLookAround)
    waitmovement(0)
    msgbox(PetalburgWoods_Text_NotAOneToBeFound, MSGBOX_DEFAULT)
    closemessage
    return
}

script PetalburgWoods_EventScript_DevonResearcherAquaEnters {
	msgbox(PetalburgWoods_Text_HaveYouSeenShroomish, MSGBOX_DEFAULT)
    closemessage
    playbgm(MUS_ENCOUNTER_AQUA, FALSE)
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, moves(walk_down * 2,  delay_16 * 2))
    waitmovement(0)
    msgbox(PetalburgWoods_Text_IWasGoingToAmbushYou, MSGBOX_DEFAULT)
    closemessage
	return
}

script PetalburgWoods_EventScript_DevonResearcherAquaBattleAndFinish {
	msgbox(PetalburgWoods_Text_NoOneCrossesTeamAqua, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_GRUNT_PETALBURG_WOODS, PetalburgWoods_Text_YoureKiddingMe)
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, moves(lock_look,  walk_up,  unlock_look))
    waitmovement(0)
    msgbox(PetalburgWoods_Text_YouveGotSomeNerve, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PETALBURG_WOODS_GRUNT, moves(run_up * 5,  delay_16 * 2))
    waitmovement(0)
    removeobject(LOCALID_PETALBURG_WOODS_GRUNT)
    applymovement(LOCALID_PLAYER, Common_Movement_StepFasterDown)
    waitmovement(0)
    msgbox(PetalburgWoods_Text_ThatWasAwfullyClose, MSGBOX_DEFAULT)
    if (giveitem(ITEM_GREAT_BALL) == FALSE) {
        msgbox(PetalburgWoods_Text_YoureLoadedWithItems, MSGBOX_DEFAULT)
    }
    msgbox(PetalburgWoods_Text_TeamAquaAfterSomethingInRustboro, MSGBOX_DEFAULT)
    applymovement(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE, moves(step_faster_down,  delay_16 * 5,  face_up))
    waitmovement(0)
    msgbox(PetalburgWoods_Text_ICantBeWastingTime, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, moves(delay_16 * 2,  step_faster_up))
	return
}

script PetalburgWoods_EventScript_RemoveDevonResearcher {
    removeobject(LOCALID_PETALBURG_WOODS_DEVON_EMPLOYEE)
    setvar(VAR_PETALBURG_WOODS_STATE, 1)
    releaseall
    end
}

movement PetalburgWoods_Movement_DevonResearcherLookAround {
    // moves(face_up,  delay_16,  delay_4,  face_right,  delay_16,  delay_8,  face_left,  delay_16,  delay_8,  face_down,  delay_16,  face_right,  delay_16,  delay_8,  face_up,  delay_16)
    face_up
    delay_16
    delay_4
    face_right
    delay_16
    delay_8
    face_left
    delay_16
    delay_8
    face_down
    delay_16
    face_right
    delay_16
    delay_8
    face_up
    delay_16
}

script PetalburgWoods_EventScript_Boy1 {
    msgbox(PetalburgWoods_Text_StayOutOfTallGrass, MSGBOX_NPC)
    end
}

script PetalburgWoods_EventScript_Boy2 {
    msgbox(PetalburgWoods_Text_HiddenItemsExplanation, MSGBOX_NPC)
    end
}

script PetalburgWoods_EventScript_Girl {
    lock_faceplayer
    if (!flag(FLAG_RECEIVED_MIRACLE_SEED)) {
        msgbox(PetalburgWoods_Text_TryUsingThisItem, MSGBOX_DEFAULT)
		if (giveitem(ITEM_MIRACLE_SEED) == FALSE) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_RECEIVED_MIRACLE_SEED)
    } else {
		msgbox(PetalburgWoods_Text_MiracleSeedExplanation, MSGBOX_DEFAULT)
	}
    release_end
}

script PetalburgWoods_EventScript_Sign1 {
    msgbox(PetalburgWoods_Text_TrainerTipsExperience, MSGBOX_SIGN)
    end
}

script PetalburgWoods_EventScript_Sign2 {
    msgbox(PetalburgWoods_Text_TrainerTipsPP, MSGBOX_SIGN)
    end
}

script PetalburgWoods_EventScript_Lyle {
    trainerbattle_single(TRAINER_LYLE, PetalburgWoods_Text_GoBugPokemonTeam, PetalburgWoods_Text_ICouldntWin)
    msgbox(PetalburgWoods_Text_ImOutOfPokeBalls, MSGBOX_AUTOCLOSE)
    end
}

script PetalburgWoods_EventScript_James {
    trainerbattle_single(TRAINER_JAMES_1, PetalburgWoods_Text_InstantlyPopularWithBugPokemon, PetalburgWoods_Text_CantBePopularIfILose, PetalburgWoods_EventScript_TryRegisterJames)
    if (specialvar(VAR_RESULT, ShouldTryRematchBattle) == TRUE) {
        trainerbattle_rematch(TRAINER_JAMES_1, PetalburgWoods_Text_MyPokemonHaveGrown, PetalburgWoods_Text_CantBePopularIfLose)
		msgbox(PetalburgWoods_Text_IveBeenTrainingHard, MSGBOX_AUTOCLOSE)
		end
    }
    setvar(VAR_0x8004, TRAINER_JAMES_1)
    if (flag(FLAG_HAS_MATCH_CALL) && specialvar(VAR_RESULT, IsTrainerRegistered) == FALSE) {
		msgbox(PetalburgWoods_Text_IWantRematch1, MSGBOX_DEFAULT)
    	register_matchcall(TRAINER_JAMES_1)
    	release_end
    }
    msgbox(PetalburgWoods_Text_PeopleRespectYou, MSGBOX_DEFAULT)
    release_end
}

script PetalburgWoods_EventScript_TryRegisterJames {
    special(PlayerFaceTrainerAfterBattle)
    waitmovement(0)
    if (flag(FLAG_HAS_MATCH_CALL)) {
        msgbox(PetalburgWoods_Text_IWantRematch1, MSGBOX_DEFAULT)
		register_matchcall(TRAINER_JAMES_1)
    }
    release_end
}

text PetalburgWoods_Text_NotAOneToBeFound {
	"Hmmm…
	They're supposed to be around here…"
}

text PetalburgWoods_Text_HaveYouSeenShroomish {
	"Hello, have you seen any SHROOMISH
	around here?

	My daughter really loves that POKéMON,
	so I thought I'd catch her one as a
	birthday present."
}

text PetalburgWoods_Text_IWasGoingToAmbushYou {
	"You know, you aren't very careful for a
	guy delivering important cargo.

	I was hoping this would be a bit more
	difficult, so I could impress the BOSS."
}

text PetalburgWoods_Text_HandOverThosePapers {
	"Now, Mushroom Man!
	Hand over that briefcase!

	And you best be quick about it unless
	you want to get hurt!"
}

text PetalburgWoods_Text_YouHaveToHelpMe {
	"Um. Uhhhh.
	Oh, no. Oh, jeez…

	You!
	You're a POKéMON TRAINER, right?

	You've got to help me, please!
	I can't let anyone have my stuff!"
}

text PetalburgWoods_Text_NoOneCrossesTeamAqua {
	"Are you serious?
	You're gonna use a kid as a meat shield?

	Kid,
	Just get lost.

	I don't wanna hurt you unless I have to.

	You're really gonna stick up for a rich,
	technocrat like this guy?

	Don't say I didn't warn you.
	You'll just have to learn the hard way.

	Come on, kid.
	Show me what you've got."
}

text PetalburgWoods_Text_YoureKiddingMe {
	"What the hell…
	but you're just some brat…"
}

text PetalburgWoods_Text_YouveGotSomeNerve {
	"Damn it, kid.
	You've really done it now.

	It ain't a good idea to go messing
	around with TEAM AQUA.

	We're trying to save the world, and
	people who get in our way don't tend to
	last very long.

	If I were you, I'd think twice the next
	time I saw a blue bandana."
}

text PetalburgWoods_Text_ThatWasAwfullyClose {
	"Phew…
	That was close.

	Thanks to you, those thugs didn't get
	their hands on company secrets, and
	I'll get to keep my job.

	Take this as a “thank you” gift."
}

text PetalburgWoods_Text_TeamAquaAfterSomethingInRustboro {
	"Anyways, I'd best get going.
	This stuff needs to go to HQ."
}

text PetalburgWoods_Text_ICantBeWastingTime {
	"Happy hunting!"
}

text PetalburgWoods_Text_YoureLoadedWithItems {
	"You're loaded with items.
	You'll have to make room."
}

text PetalburgWoods_Text_GoBugPokemonTeam {
	"I caught a whole bunch of POKéMON!

	Go, go, go!
	My BUG POKéMON team!"
}

text PetalburgWoods_Text_ICouldntWin {
	"I have all these POKéMON,
	but I couldn't win…"
}

text PetalburgWoods_Text_ImOutOfPokeBalls {
	"I caught a bunch of POKéMON.
	Now I'm out of POKé BALLS."
}

text PetalburgWoods_Text_InstantlyPopularWithBugPokemon {
	"If you take BUG POKéMON to school,
	you get to be instantly popular!"
}

text PetalburgWoods_Text_CantBePopularIfILose {
	"I can't be popular if I lose."
}

text PetalburgWoods_Text_PeopleRespectYou {
	"If you have a big BUG POKéMON,
	people respect you for it."
}

text PetalburgWoods_Text_IWantRematch1 {
	"I want a rematch when my BUG
	POKéMON grow up!

	I'm registering you in my POKéNAV!"
}

text PetalburgWoods_Text_MyPokemonHaveGrown {
	"My BUG POKéMON have grown.
	I'll be popular again."
}

text PetalburgWoods_Text_CantBePopularIfLose {
	"I can't be popular if I lose."
}

text PetalburgWoods_Text_IveBeenTrainingHard {
	"You get to be popular if you have
	strong POKéMON, right?
	So, I've been training hard."
}

text PetalburgWoods_Text_StayOutOfTallGrass {
	"Yo, there!
	Your POKéMON doing okay?

	If your POKéMON are weak and you want
	to avoid battles, you should stay out
	of tall grass."
}

text PetalburgWoods_Text_HiddenItemsExplanation {
	"Sometimes, there are things on the
	ground even if you can't see them.

	That's why I always check where I'm
	walking."
}

text PetalburgWoods_Text_TryUsingThisItem {
	"Oh, neat!
	That's the BADGE from RUSTBORO GYM!

	You must be a TRAINER.
	You should try using this item."
}

text PetalburgWoods_Text_MiracleSeedExplanation {
	"It's a MIRACLE SEED.
	If a POKéMON holds that item, its
	GRASS-type moves become stronger.

	Besides MIRACLE SEED, I think there are
	other convenient items for POKéMON
	to hold."
}

text PetalburgWoods_Text_TrainerTipsExperience {
	"TRAINER TIPS

	Any POKéMON that appears even once
	in a battle is awarded EXP Points.

	To raise a weak POKéMON, put it at the
	left of the team list.

	As soon as a battle starts, switch it
	out. It will earn EXP Points without
	being exposed to any harm."
}

text PetalburgWoods_Text_TrainerTipsPP {
	"TRAINER TIPS

	In addition to Hit Points (HP), POKéMON
	have Power Points (PP) that are used to
	make moves during battle.

	If a POKéMON runs out of PP, it must be
	taken to a POKéMON CENTER."
}
