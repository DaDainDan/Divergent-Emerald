script Route102_EventScript_Avery {
    trainerbattle_single(TRAINER_AVERY, Route102_Text_AveryIntro, Route102_Text_AveryDefeated)
    msgbox(Route102_Text_AveryPostBattle, MSGBOX_AUTOCLOSE)
    end
}

