text FortreeCity_Text_ToxicSpikesDesc {
	"Sets toxic spikes\n"
	"on the foe's field.\n"
	"Poisons on entry."
}

text FortreeCity_Text_IceShardsDesc {
	"Sets ice spikes\n"
	"on the foe's field.\n"
	"Damages on entry."
}

text FortreeCity_Text_BoobyTrapDesc {
