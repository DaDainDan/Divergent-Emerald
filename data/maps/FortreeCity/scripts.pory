mapscripts FortreeCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_FORTREE_CITY)
		if (!flag(FLAG_KECLEON_FLED_FORTREE)) {
			clearflag(FLAG_HIDE_FORTREE_CITY_KECLEON)
		}
    	end
    }
    MAP_SCRIPT_ON_RESUME {
		if (flag(FLAG_SYS_CTRL_OBJ_DELETE) && specialvar(VAR_RESULT, GetBattleOutcome) == B_OUTCOME_CAUGHT) {
			removeobject(VAR_LAST_TALKED)
		}
        setstepcallback(STEP_CB_FORTREE_BRIDGE)
    	end
    }
}

script FortreeCity_EventScript_Man {
    msgbox(FortreeCity_Text_SawGiganticPokemonInSky, MSGBOX_NPC)
    end
}

script FortreeCity_EventScript_Woman {
    lock_faceplayer
    if (flag(FLAG_KECLEON_FLED_FORTREE)) {
        msgbox(FortreeCity_Text_ThisTimeIllBeatWinona, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(FortreeCity_Text_SomethingBlockingGym, MSGBOX_DEFAULT)
    release_end
}

script FortreeCity_EventScript_Girl {
    msgbox(FortreeCity_Text_TreesGrowByDrinkingRainwater, MSGBOX_NPC)
    end
}

script FortreeCity_EventScript_OldMan {
    msgbox(FortreeCity_Text_EveryoneHealthyAndLively, MSGBOX_NPC)
    end
}

script FortreeCity_EventScript_Boy {
    msgbox(FortreeCity_Text_BugPokemonComeThroughWindow, MSGBOX_NPC)
    end
}

script FortreeCity_EventScript_GameboyKid {
    msgbox(FortreeCity_Text_PokemonThatEvolveWhenTraded, MSGBOX_NPC)
    end
}

script FortreeCity_EventScript_CitySign {
    msgbox(FortreeCity_Text_CitySign, MSGBOX_SIGN)
    end
}

script FortreeCity_EventScript_GymSign {
    msgbox(FortreeCity_Text_GymSign, MSGBOX_SIGN)
    end
}

script FortreeCity_EventScript_Kecleon {
    lock_faceplayer
    msgbox(FortreeCity_Text_UnseeableUseDevonScope, MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox(FortreeCity_Text_UsedDevonScopePokemonFled, MSGBOX_DEFAULT)
		closemessage
		applymovement(VAR_LAST_TALKED, Movement_KecleonAppears)
		waitmovement(0)
		waitse
		playmoncry(SPECIES_KECLEON, CRY_MODE_ENCOUNTER)
		delay(40)
		waitmoncry
		setwildbattle(SPECIES_KECLEON, 40, ITEM_SITRUS_BERRY, SPECIES_KECLEON, 40, ITEM_WIKI_BERRY)
		setflag(FLAG_SYS_CTRL_OBJ_DELETE)
		dowildbattle
		clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
		setflag(FLAG_KECLEON_FLED_FORTREE)
		specialvar(VAR_RESULT, GetBattleOutcome)
		if (var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_RAN 
		|| var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
			goto(Common_EventScript_RemoveStaticPokemon)
		}
	}
    release_end
}

script FortreeCity_EventScript_NinjaBoyMerchant {
    lock_faceplayer
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(FortreeCity_NinjaTMs)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release_end
}

mart FortreeCity_NinjaTMs {
    ITEM_TM_PURSUIT
    ITEM_TM_KNOCK_OFF
    ITEM_TM_ACID_SPRAY
    ITEM_TM_AGILITY
}

script FortreeCity_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_FORTREE_NINJA_TUTOR)) {
		msgbox("\.", MSGBOX_DEFAULT)
		setflag(FLAG_MET_FORTREE_NINJA_TUTOR)
	}
	msgbox("\.", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_SIDE_STATUS_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(FortreeCity_EventScript_ChooseSideStatusMove)
	end
}

script FortreeCity_EventScript_ChooseSideStatusMove {
	setvar(VAR_0x8004, SCROLL_MULTI_SIDE_STATUS_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_STEALTH_ROCK)
		case 1: setvar(VAR_0x8005, MOVE_SPIKES)
		case 2: setvar(VAR_0x8005, MOVE_TOXIC_SPIKES)
		case 3: setvar(VAR_0x8005, MOVE_ICE_SHARDS)
		case 4: setvar(VAR_0x8005, MOVE_BOOBY_TRAP)
		case 5: setvar(VAR_0x8005, MOVE_BARRIER)
		case 6: setvar(VAR_0x8005, MOVE_LIGHT_SCREEN)
		case 7: setvar(VAR_0x8005, MOVE_REFLECT)
		case 8: setvar(VAR_0x8005, MOVE_AURORA_VEIL)
		case 9:
		case MULTI_B_PRESSED:
			goto(FortreeCity_EventScript_ExitTutorMoveSelect)
	}
	goto(FortreeCity_EventScript_ConfirmMoveSelection)
	end
}

script FortreeCity_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(FortreeCity_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script FortreeCity_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	msgbox("\.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("\.")
		waitmessage
		setvar(VAR_0x8006, 1)
		goto(FortreeCity_EventScript_ChooseSideStatusMove)
	}
	if (checkitem(ITEM_GREEN_SHARD) == TRUE) {
		msgbox("\.", MSGBOX_DEFAULT)
		fadescreen(FADE_TO_BLACK)
		special(CloseBattleFrontierTutorWindow)
		chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			msgbox(FortreeCity_Text_DeclineTutor, MSGBOX_DEFAULT)
			release_end
		}
		msgbox("\.", MSGBOX_DEFAULT)
		removeitem(ITEM_GREEN_SHARD, 1)
		release_end
	}
	msgbox("\.", MSGBOX_DEFAULT)
	goto(FortreeCity_EventScript_ExitTutorMoveSelect)
	end
}

text FortreeCity_Text_DeclineTutor {
	"\."
}

text FortreeCity_Text_SawGiganticPokemonInSky {
	"No one believes me, but I saw this
	gigantic POKéMON in the sky.

	It seemed to squirm as it flew toward
	ROUTE 131.

	By the way… Sniff…
	Um… You, uh…smell singed.

	Were you at a volcano or something?"
}

text FortreeCity_Text_SomethingBlockingGym {
	"I want to go to the POKéMON GYM,
	but something's blocking the way.

	After all the bother I went through
	training on ROUTE 120…"
}

text FortreeCity_Text_ThisTimeIllBeatWinona {
	"I've got my pride-and-joy POKéMON
	with me. This time, I'll beat WINONA."
}

text FortreeCity_Text_TreesGrowByDrinkingRainwater {
	"The ground absorbs rainwater, and
	trees grow by drinking that water…

	Our FORTREE CITY exists because
	there's both water and soil."
}

text FortreeCity_Text_EveryoneHealthyAndLively {
	"The CITY consists of homes built on
	trees.

	Perhaps because of that lifestyle,
	everyone is healthy and lively.

	Why, even myself--I feel as if I've
	grown thirty years younger."
}

text FortreeCity_Text_BugPokemonComeThroughWindow {
	"Living on top of trees is okay.

	But sometimes BUG POKéMON come in
	through windows.
	It can be really startling."
}

text FortreeCity_Text_PokemonThatEvolveWhenTraded {
	"There are POKéMON that evolve when
	you trade them! That's what I heard."
}

text FortreeCity_Text_SomethingUnseeable {
	"Something unseeable is in the way."
}

text FortreeCity_Text_UnseeableUseDevonScope {
	"Something unseeable is in the way.

	Are you sure you want to disturb it?"
}

text FortreeCity_Text_UsedDevonScopePokemonFled {
	"{PLAYER} prodded the invisible 
	obstacle.

	Two invisible POKéMON revealed
	themselves.

	The startled POKéMON attacked!"
}

text FortreeCity_Text_CitySign {
	"FORTREE CITY
	“The treetop city that frolics with
	nature.”"
}

text FortreeCity_Text_GymSign {
	"FORTREE CITY POKéMON GYM
	LEADER: WINONA

	“The bird user taking flight into
	the world.”"
}

