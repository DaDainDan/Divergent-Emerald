	"Creates a field of\n"
	"voltage to double\n"
	"stat changes."
}

text AlteringCave_B2F_Text_PsychicTerrainDesc {
	"Creates a psychic\n"
	"field that negates\n"
	"priority."
}

text AlteringCave_B2F_Text_MistyTerrainDesc {
	"Creates a field of\n"
	"mist that negates\n"
	"status ailments."
