mapscripts AlteringCave_B2F_MapScripts {}

script AlteringCave_B2F_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_ALTERING_CAVE_TERRAIN_TUTOR)) {
		msgbox("\.", MSGBOX_DEFAULT)
		setflag(FLAG_MET_ALTERING_CAVE_TERRAIN_TUTOR)
	}
	msgbox("\.", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_TERRAIN_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(AlteringCave_B2F_EventScript_ChooseTerrainMove)
	end
}

script AlteringCave_B2F_EventScript_ChooseTerrainMove {
	setvar(VAR_0x8004, SCROLL_MULTI_TERRAIN_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_GRASSY_TERRAIN)
		case 1: setvar(VAR_0x8005, MOVE_ELECTRIC_TERRAIN)
		case 2: setvar(VAR_0x8005, MOVE_PSYCHIC_TERRAIN)
		case 3: setvar(VAR_0x8005, MOVE_MISTY_TERRAIN)
		case 4: setvar(VAR_0x8005, MOVE_BUGGY_TERRAIN)
		case 5: setvar(VAR_0x8005, MOVE_FAULTY_TERRAIN)
		case 6: setvar(VAR_0x8005, MOVE_SPOOKY_TERRAIN)
		case 7: setvar(VAR_0x8005, MOVE_TERRAIN_PULSE)
		case 8:
		case MULTI_B_PRESSED:
			goto(AlteringCave_B2F_EventScript_ExitTutorMoveSelect)
	}
	special(BufferBattleFrontierTutorMoveName)
	msgbox("\.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("\.")
        waitmessage
        setvar(VAR_0x8006, 1)
        goto(AlteringCave_B2F_EventScript_ChooseTerrainMove)
	}
	if (checkitem(ITEM_NUGGET) == TRUE) {
		msgbox("\.", MSGBOX_DEFAULT)
        fadescreen(FADE_TO_BLACK)
        special(CloseBattleFrontierTutorWindow)
        chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
        waitstate
        if (var(VAR_RESULT) == FALSE) {
            msgbox(AlteringCave_B2F_Text_DeclineTutor, MSGBOX_DEFAULT)
            release_end
        }
        msgbox("\.", MSGBOX_DEFAULT)
        removeitem(ITEM_NUGGET, 1)
        release_end
	}
	msgbox("\.", MSGBOX_DEFAULT)
	goto(AlteringCave_B2F_EventScript_ExitTutorMoveSelect)
	end
}

script AlteringCave_B2F_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(AlteringCave_B2F_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

text AlteringCave_B2F_Text_DeclineTutor {
	"\."
}

text AlteringCave_B2F_Text_GrassyTerrainDesc {
	"Creates a grassy\n"
	"field that heals\n"
	"all Pokémon."
}

