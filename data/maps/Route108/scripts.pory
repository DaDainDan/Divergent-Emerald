script Route108_EventScript_Christine {
    trainerbattle_single(TRAINER_CHRISTINE, Route108_Text_ChristineIntro, Route108_Text_ChristineDefeated)
    msgbox(Route108_Text_ChristinePostBattle, MSGBOX_AUTOCLOSE)
    end
