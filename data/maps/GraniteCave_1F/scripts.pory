mapscripts GraniteCave_1F_MapScripts {}

script GraniteCave_1F_EventScript_Hiker {
    lock_faceplayer
    msgbox(GraniteCave_1F_Text_GetsDarkAheadHereYouGo, MSGBOX_DEFAULT)
    release_end
}

text GraniteCave_1F_Text_GetsDarkAheadHereYouGo {
	"Hey, you.
	It gets awfully dark ahead.
	It'll be tough trying to explore.

	That guy who came by earlier…
	He knew how to use FLASH, so he ought
	to be all right, but…

	I would tread lightly, if I were you."
}

text GraniteCave_1F_Text_ExplainFlash {
	"Teach that hidden move FLASH to
	a POKéMON and use it.

	It lights up even the inky darkness
	of caves.

	But, to use it, you need the GYM BADGE
	from DEWFORD's POKéMON GYM."
}
