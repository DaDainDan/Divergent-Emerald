mapscripts Route119_WeatherInstitute_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (var(VAR_WEATHER_INSTITUTE_STATE) == 0) {
			setobjectxyperm(LOCALID_WEATHER_INSTITUTE_LITTLE_BOY, 0, 5)
			setobjectmovementtype(LOCALID_WEATHER_INSTITUTE_LITTLE_BOY, MOVEMENT_TYPE_FACE_RIGHT)
		}
		end
    }
}

script Route119_WeatherInstitute_1F_EventScript_LittleBoy {
    lock_faceplayer
    special(GetPlayerBigGuyGirlString)
    if (var(VAR_WEATHER_INSTITUTE_STATE) == 0) {
        msgbox(Route119_WeatherInstitute_1F_Text_EveryoneWentUpstairs, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(Route119_WeatherInstitute_1F_Text_WowYoureStrong, MSGBOX_DEFAULT)
    release_end
}

script Route119_WeatherInstitute_1F_EventScript_InstituteWorker1 {
    lock_faceplayer
	setvar(VAR_0x8004, 0)
    if (flag(FLAG_DEFEATED_KYOGRE)) {
        addvar(VAR_0x8004, 1)
    }
    if (flag(FLAG_DEFEATED_GROUDON)) {
        addvar(VAR_0x8004, 1)
    }
    if (!flag(FLAG_SYS_GAME_CLEAR) || var(VAR_0x8004) == 2) { // Both defeated
        msgbox(Route119_WeatherInstitute_1F_Text_ProfStudyingRain, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(Route119_WeatherInstitute_1F_Text_NoticingAbnormalWeather, MSGBOX_DEFAULT)
    release_end
}

script Route119_WeatherInstitute_1F_EventScript_InstituteWorker2 {
    msgbox(Route119_WeatherInstitute_1F_Text_WhatWereAquasUpTo, MSGBOX_NPC)
    end
}

script Route119_WeatherInstitute_1F_EventScript_Bed {
    lockall
    msgbox(Route119_WeatherInstitute_1F_Text_TakeRestInBed, MSGBOX_DEFAULT)
    closemessage
    call(Common_EventScript_OutOfCenterPartyHeal)
    releaseall
    end
}

script Route119_WeatherInstitute_1F_EventScript_Grunt1 {
    trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_1, Route119_WeatherInstitute_1F_Text_Grunt1Intro, Route119_WeatherInstitute_1F_Text_Grunt1Defeat)
    msgbox(Route119_WeatherInstitute_1F_Text_Grunt1PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route119_WeatherInstitute_1F_EventScript_Grunt4 {
    trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_4, Route119_WeatherInstitute_1F_Text_Grunt4Intro, Route119_WeatherInstitute_1F_Text_Grunt4Defeat)
    msgbox(Route119_WeatherInstitute_1F_Text_Grunt4PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Route119_WeatherInstitute_1F_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_WEATHER_INSTITUTE_TUTOR)) {
		msgbox("\.", MSGBOX_DEFAULT)
		setflag(FLAG_MET_WEATHER_INSTITUTE_TUTOR)
	}
	msgbox("\.", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_WEATHER_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(Route119_WeatherInstitute_1F_EventScript_ChooseWeatherMove)
	end
}

script Route119_WeatherInstitute_1F_EventScript_ChooseWeatherMove {
	setvar(VAR_0x8004, SCROLL_MULTI_WEATHER_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_SUNNY_DAY)
		case 1: setvar(VAR_0x8005, MOVE_RAIN_DANCE)
		case 2: setvar(VAR_0x8005, MOVE_SANDSTORM)
		case 3: setvar(VAR_0x8005, MOVE_SNOWSCAPE)
		case 4: setvar(VAR_0x8005, MOVE_STORM_CALL)
		case 5: setvar(VAR_0x8005, MOVE_WEATHER_BALL)
		case 6:
		case MULTI_B_PRESSED:
			goto(Route119_WeatherInstitute_1F_EventScript_ExitTutorMoveSelect)
	}
	goto(Route119_WeatherInstitute_1F_EventScript_ConfirmMoveSelection)
	end
}

script Route119_WeatherInstitute_1F_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(Route119_WeatherInstitute_1F_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script Route119_WeatherInstitute_1F_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	msgbox("\.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("\.")
		waitmessage
		setvar(VAR_0x8006, 1)
		goto(Route119_WeatherInstitute_1F_EventScript_ChooseWeatherMove)
	}
	if (checkitem(ITEM_STARDUST) == TRUE) {
		msgbox("\.", MSGBOX_DEFAULT)
		fadescreen(FADE_TO_BLACK)
		special(CloseBattleFrontierTutorWindow)
		chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			msgbox(Route119_WeatherInstitute_1F_Text_DeclineTutor, MSGBOX_DEFAULT)
			release_end
		}
		msgbox("\.", MSGBOX_DEFAULT)
		removeitem(ITEM_STARDUST, 1)
		release_end
	}
	msgbox("\.", MSGBOX_DEFAULT)
	goto(Route119_WeatherInstitute_1F_EventScript_ExitTutorMoveSelect)
	end
}

text Route119_WeatherInstitute_1F_Text_DeclineTutor {
	"\."
}

text Route119_WeatherInstitute_1F_Text_Grunt1Intro {
	"The BOSS got interested in
	the research they have going here,
	so he sent us out.

	You quit meddling!"
}

text Route119_WeatherInstitute_1F_Text_Grunt1Defeat {
	"Blast it…
	Blasted by a kid…"
}

text Route119_WeatherInstitute_1F_Text_Grunt1PostBattle {
	"Our BOSS knows everything.

	But I'm just a GRUNT. What would I know
	about what he's thinking?"
}

text Route119_WeatherInstitute_1F_Text_Grunt4Intro {
	"Huh?
	What's a kid doing here?"
}

text Route119_WeatherInstitute_1F_Text_Grunt4Defeat {
	"Huh?
	I lost?!"
}

text Route119_WeatherInstitute_1F_Text_Grunt4PostBattle {
	"Oh, no…
	I'll catch an earful for losing to a kid…

	I should just take a nap in the bed…"
}

text Route119_WeatherInstitute_1F_Text_EveryoneWentUpstairs {
	"While I was sleeping, everyone went
	upstairs!"
}

text Route119_WeatherInstitute_1F_Text_WowYoureStrong {
	"Wow, you're really strong!

	I wish I could be a POKéMON TRAINER
	like you!"
}

text Route119_WeatherInstitute_1F_Text_ProfStudyingRain {
	"The PROFESSOR loves rain.
	That's a fact.

	But if it keeps raining, people will be in
	trouble. That's another fact.

	And thus, the PROFESSOR is studying
	if the rain can be put to good use."
}

text Route119_WeatherInstitute_1F_Text_NoticingAbnormalWeather {
	"On the 2nd floor of the INSTITUTE,
	we study the weather patterns over
	the HOENN region.

	We've been noticing temporary and
	isolated cases of droughts and
	heavy rain lately…"
}

text Route119_WeatherInstitute_1F_Text_WhatWereAquasUpTo {
	"Hello!
	We've been saved by your actions!

	What I don't understand is what on
	earth the AQUAS were up to."
}

text Route119_WeatherInstitute_1F_Text_TakeRestInBed {
	"There's a bed…
	Let's take a rest."
}

text Route119_WeatherInstitute_1F_Text_SunnyDayDesc {
	"Turns the weather\n"
	"to harsh sunlight.\n"
	"Unique effects."
}

text Route119_WeatherInstitute_1F_Text_RainDanceDesc {
	"Turns the weather\n"
	"to heavy rain.\n"
	"Unique effects."
}

text Route119_WeatherInstitute_1F_Text_SandstormDesc {
	"Stirs up a storm\n"
	"of sand that can\n"
	"deal chip damage."
}

text Route119_WeatherInstitute_1F_Text_SnowscapeDesc {
	"Turns the weather\n"
	"to a snowstorm.\n"
	"Unique effects."
}

text Route119_WeatherInstitute_1F_Text_StormCallDesc {
	"Creates strong\n"
	"winds that negate\n"
	"weather for a bit."
}

text Route119_WeatherInstitute_1F_Text_WeatherBallDesc {
	"A ball of energy\n"
	"that changes type\n"
	"based on weather."
}
