mapscripts RustboroCity_CuttersHouse_MapScripts {}

script RustboroCity_CuttersHouse_EventScript_Lass {
	msgbox(RustboroCity_CuttersHouse_Text_WontStopTraining, MSGBOX_NPC)
	end
}

script RustboroCity_CuttersHouse_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_RUSTBORO_CUTTING_TUTOR)) {
		msgbox(RustboroCity_CuttersHouse_Text_CutterIntro, MSGBOX_DEFAULT)
		setflag(FLAG_MET_RUSTBORO_CUTTING_TUTOR)
	}
	if (!flag(FLAG_BADGE05_GET)) {
		msgbox(RustboroCity_CuttersHouse_Text_UnworthyNovice, MSGBOX_DEFAULT)
		release_end
	}
	if (!flag(FLAG_CUTTER_REQUIREMENT)) {
		msgbox(RustboroCity_CuttersHouse_Text_YouAreWorthy, MSGBOX_DEFAULT)
		setflag(FLAG_CUTTER_REQUIREMENT)
	} else {
		msgbox(RustboroCity_CuttersHouse_Text_ChooseTechnique, MSGBOX_DEFAULT)
	}
	setvar(VAR_TEMP_C, SCROLL_MULTI_CUTTER_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(RustboroCity_CuttersHouse_EventScript_ChooseCutterMove)
	end
}

script RustboroCity_CuttersHouse_EventScript_ChooseCutterMove {
	setvar(VAR_0x8004, SCROLL_MULTI_CUTTER_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setvar(VAR_0x8005, MOVE_SLASH)
		case 1: setvar(VAR_0x8005, MOVE_NIGHT_SLASH)
		case 2: setvar(VAR_0x8005, MOVE_LEAF_BLADE)
		case 3: setvar(VAR_0x8005, MOVE_AERIAL_ACE)
		case 4: setvar(VAR_0x8005, MOVE_AIR_SLASH)
		case 5: setvar(VAR_0x8005, MOVE_PSYCHO_CUT)
		case 6: setvar(VAR_0x8005, MOVE_AQUA_CUTTER)
		case 7: setvar(VAR_0x8005, MOVE_SHINING_SLASH)
		case 8: setvar(VAR_0x8005, MOVE_HONE_CLAWS)
		case 9:
		case MULTI_B_PRESSED:
			goto(RustboroCity_CuttersHouse_EventScript_ExitTutorMoveSelect)
	}
	goto(RustboroCity_CuttersHouse_EventScript_ConfirmMoveSelection)
	end
}

script RustboroCity_CuttersHouse_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow) 
	msgbox(RustboroCity_CuttersHouse_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script RustboroCity_CuttersHouse_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	msgbox(RustboroCity_CuttersHouse_Text_TributeRedShard, MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("Is there another technique you wish
			 to master?")
		waitmessage
		setvar(VAR_0x8006, 1)
		goto(RustboroCity_CuttersHouse_EventScript_ChooseCutterMove)
	}
	if (checkitem(ITEM_RED_SHARD) == TRUE) {
		msgbox("Which of your POK\eMON shall learn
			this technique?", MSGBOX_DEFAULT)
		fadescreen(FADE_TO_BLACK)
		special(CloseBattleFrontierTutorWindow)
		chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			msgbox(RustboroCity_CuttersHouse_Text_DeclineTutor, MSGBOX_DEFAULT)
			release_end
		}
		msgbox("Grant me more RED SHARDS, and my power
				will become yours.", MSGBOX_DEFAULT)
		removeitem(ITEM_RED_SHARD, 1)
		release_end
	}
	msgbox(RustboroCity_CuttersHouse_Text_NoRedShard, MSGBOX_DEFAULT)
	goto(RustboroCity_CuttersHouse_EventScript_ExitTutorMoveSelect)
	end
}

text RustboroCity_CuttersHouse_Text_DeclineTutor {
	"Hah, pupils don't waste a master's time.

	A true swordsman is swift and resolute.
	One who hesitates is doomed for defeat."
}

text RustboroCity_CuttersHouse_Text_NoRedShard {
	"Unacceptable.
	
	Return once you obtain a RED SHARD."
}

text RustboroCity_CuttersHouse_Text_TributeRedShard {
	"They say RED SHARDS originate from
	the war ornaments of old.
			
	I will always demand one as tribute.
			
	Are you prepared to pay a RED SHARD
	as tribute?"
}

text RustboroCity_CuttersHouse_Text_ChooseTechnique {
	"Back to learn more arts of the blade?
				
	Very well.

	What technique invigorates your
	fighting spirit?"
}

text RustboroCity_CuttersHouse_Text_YouAreWorthy {
	"So\.
	You've defeated NORMAN, have you?

	You are worthy of my skills after all.
			
	Now, what skill shall I teach first?"
}

text RustboroCity_CuttersHouse_Text_UnworthyNovice {
	"You are still a novice and naive to the 
	art of battle.
				
	You are not yet worthy of my teachings.
				
	Return once you have refined your
	skills and earned many more victories."
}

text RustboroCity_CuttersHouse_Text_CutterIntro {
	"Hello, young TRAINER.
	I'm known as the CUTTER.

	I am known by that name because I have 
	fully mastered the art of the sword.
			
	Many seek to be my students, but few
	are worthy of becoming my pupil."
}

text RustboroCity_CuttersHouse_Text_WontStopTraining {
	"My grandfather still won't let me be 
	his apprentice.
			
	I won't stop training until he thinks 
	I'm worthy enough."
}

text RustboroCity_CuttersHouse_Text_SlashDesc {
	"A Normal-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_NightSlashDesc {
	"A Dark-type slash\n"
	"that always crits\n"
	"low HP targets."
}

text RustboroCity_CuttersHouse_Text_LeafBladeDesc {
	"A Grass-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_SwallowReversalDesc {
	"A Flying-type\n"
	"slash that ignores\n"
	"protection."
}

text RustboroCity_CuttersHouse_Text_AirSlashDesc {
	"A Flying-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_PsychoCutDesc {
	"A Psychic-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_AquaCutterDesc {
	"A Water-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_ShiningSlashDesc {
	"A Steel-type\n"
	"slash that has\n"
	"high crit rate."
}

text RustboroCity_CuttersHouse_Text_HoneEdgeDesc {
	"A sharpening move\n"
	"that increases\n"
	"Atk and crit rate."
}
