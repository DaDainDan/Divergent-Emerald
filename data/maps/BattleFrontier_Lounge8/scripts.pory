mapscripts BattleFrontier_Lounge8_MapScripts {}

script BattleFrontier_Lounge8_EventScript_Man {
    msgbox(BattleFrontier_Lounge8_Text_WhatATrainerNeeds, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge8_EventScript_Woman {
    msgbox(BattleFrontier_Lounge8_Text_KnowAboutFrontierBrains, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge8_EventScript_NinjaBoy {
    msgbox(BattleFrontier_Lounge8_Text_ToldMeIHaveTalentForBattling, MSGBOX_NPC)
    end
}

script BattleFrontier_Lounge8_EventScript_MoveTutor {
	lock_faceplayer
	if (!flag(FLAG_MET_BATTLE_FRONTIER_EXPLOSION_TUTOR)) {
		msgbox("\.", MSGBOX_DEFAULT)
		setflag(FLAG_MET_BATTLE_FRONTIER_EXPLOSION_TUTOR)
	}
	msgbox("\.", MSGBOX_DEFAULT)
	setvar(VAR_TEMP_C, SCROLL_MULTI_EXPLOSION_MOVE_TUTOR)
	setvar(VAR_0x8006, 0)
	goto(BattleFrontier_Lounge8_EventScript_ChooseExplosionMove)
	end
}

script BattleFrontier_Lounge8_EventScript_ChooseExplosionMove {
	special(ShowBattlePointsWindow)
	setvar(VAR_0x8004, SCROLL_MULTI_EXPLOSION_MOVE_TUTOR)
	special(ShowScrollableMultichoice)
	copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0: setmoveandprice(MOVE_SUPERNOVA, 48)
		case 1: setmoveandprice(MOVE_OSMOTIC_BURST, 48)
		case 2: setmoveandprice(MOVE_BRUMAL_BURST, 48)
		case 3: setmoveandprice(MOVE_SAND_BURST, 48)
		case 4: setmoveandprice(MOVE_CHLOROBLAST, 48)
		case 5: setmoveandprice(MOVE_WITS_END, 48)
		case 6: setmoveandprice(MOVE_MISTY_EXPLOSION, 48)
		case 7: setmoveandprice(MOVE_ARC_BLAST, 48)
		case 8: setmoveandprice(MOVE_RECKLESS_UPHEAVAL, 48)
		case 9: setmoveandprice(MOVE_BUG_BURST, 48)
		case 10: setmoveandprice(MOVE_SOUL_SHATTER, 48)
		case 11: setmoveandprice(MOVE_ROCK_RUPTURE, 48)
		case 12: setmoveandprice(MOVE_BLAST_SHELL, 48)
		case 13: setmoveandprice(MOVE_NOXIOUS_BLOWOUT, 48)
		case 14: setmoveandprice(MOVE_SHATTER, 48)
		case 15:
		case MULTI_B_PRESSED:
			goto(BattleFrontier_Lounge8_EventScript_ExitTutorMoveSelect)
	}
	goto(BattleFrontier_Lounge8_EventScript_ConfirmMoveSelection)
	end
}

script BattleFrontier_Lounge8_EventScript_ExitTutorMoveSelect {
	special(CloseBattleFrontierTutorWindow)
	special(CloseBattlePointsWindow) 
	msgbox(BattleFrontier_Lounge8_Text_DeclineTutor, MSGBOX_DEFAULT)
	release_end
}

script BattleFrontier_Lounge8_EventScript_ConfirmMoveSelection {
	special(BufferBattleFrontierTutorMoveName)
	buffernumberstring(STR_VAR_2, VAR_EXCHANGE_PRICE)
	msgbox("\.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		message("\.")
		waitmessage
		setvar(VAR_0x8006, 1)
		goto(BattleFrontier_Lounge8_EventScript_ChooseExplosionMove)
	}
	if (specialvar(VAR_TEMP_1, GetFrontierBattlePoints) >= VAR_EXCHANGE_PRICE) {
		msgbox("\.", MSGBOX_DEFAULT)
		fadescreen(FADE_TO_BLACK)
		special(CloseBattlePointsWindow)
		special(CloseBattleFrontierTutorWindow)
		chooseboxmon(SELECT_PC_MON_MOVE_TUTOR)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			msgbox(BattleFrontier_Lounge8_Text_DeclineTutor, MSGBOX_DEFAULT)
			release_end
		}
		msgbox("\.", MSGBOX_DEFAULT)
		copyvar(VAR_0x8004, VAR_EXCHANGE_PRICE)
		special(TakeFrontierBattlePoints)
		release_end
	}
	msgbox("\.", MSGBOX_DEFAULT)
	goto(BattleFrontier_Lounge8_EventScript_ExitTutorMoveSelect)
	end
}

text BattleFrontier_Lounge8_Text_DeclineTutor {
	"\."
}

text BattleFrontier_Lounge8_Text_WhatATrainerNeeds {
	"What a TRAINER needs…

	Knowledge…
	Strategy…
	Luck…
	Guts…
	Spirit…
	Bravery…
	And ability…

	Well, I'm all set in every way!
	I'll be unstoppable at every building!

	Huh? POKéMON?
	What's that?"
}

text BattleFrontier_Lounge8_Text_KnowAboutFrontierBrains {
	"Do you know about the FRONTIER
	BRAINS?

	That's what SCOTT calls the seven
	special TRAINERS that run the seven
	facilities in the BATTLE FRONTIER."
}

text BattleFrontier_Lounge8_Text_ToldMeIHaveTalentForBattling {
	"At the BATTLE TOWER, an older girl
	told me that I have a lot of talent
	for battling!

	I like POKéMON CONTESTS more!

	But I'm no good at CONTESTS!

	I guess having talent and liking
	something aren't the same."
}

