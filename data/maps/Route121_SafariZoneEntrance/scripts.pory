mapscripts Route121_SafariZoneEntrance_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_SAFARI_ZONE_STATE, 1 {
			lockall
			applymovement(LOCALID_PLAYER, moves(walk_up,  walk_right * 7))
			waitmovement(0)
			setvar(VAR_SAFARI_ZONE_STATE, 0)
			releaseall
			end
		}
    ]
}

script Route121_SafariZoneEntrance_EventScript_WelcomeAttendant {
    msgbox(Route121_SafariZoneEntrance_Text_WelcomeToSafariZone, MSGBOX_NPC)
    end
}

script Route121_SafariZoneEntrance_EventScript_InfoAttendant {
    lock_faceplayer
    msgbox(Route121_SafariZoneEntrance_Text_WelcomeFirstTime, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox(Route121_SafariZoneEntrance_Text_FirstTimeInfo, MSGBOX_DEFAULT)
    	release_end
    }
    msgbox(Route121_SafariZoneEntrance_Text_ComeInAndEnjoy, MSGBOX_DEFAULT)
    release_end
}

script Route121_SafariZoneEntrance_EventScript_EntranceCounterTrigger {
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_StepFasterUp)
    waitmovement(0)
    showmoneybox(0, 0)
    msgbox(Route121_SafariZoneEntrance_Text_WouldYouLikeToPlay, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(Route121_SafariZoneEntrance_EventScript_TryEnterSafariZone)
    }
    msgbox(Route121_SafariZoneEntrance_Text_PlayAnotherTime, MSGBOX_DEFAULT)
    goto(Route121_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter)
    end
}

script Route121_SafariZoneEntrance_EventScript_TryEnterSafariZone {
    if (checkitem(ITEM_POKEBLOCK_CASE) == FALSE) {
        msgbox(Route121_SafariZoneEntrance_Text_YouNeedPokeblockCase, MSGBOX_DEFAULT)
    	goto(Route121_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter)
    }
    if (getpartysize == PARTY_SIZE && specialvar(VAR_RESULT, ScriptCheckFreePokemonStorageSpace) == FALSE) {
        msgbox(Route121_SafariZoneEntrance_Text_PCIsFull, MSGBOX_DEFAULT)
    	goto(Route121_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter)
    }
    if (checkmoney(500) == FALSE) {
        msgbox(Route121_SafariZoneEntrance_Text_NotEnoughMoney, MSGBOX_DEFAULT)
    	goto(Route121_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter)
    }
    playse(SE_SHOP)
    msgbox(Route121_SafariZoneEntrance_Text_ThatWillBe500Please, MSGBOX_DEFAULT)
    removemoney(500)
    updatemoneybox
    msgbox(Route121_SafariZoneEntrance_Text_HereAreYourSafariBalls, MSGBOX_DEFAULT)
    playfanfare(MUS_OBTAIN_ITEM)
    message(Route121_SafariZoneEntrance_Text_Received30SafariBalls)
    waitfanfare
    msgbox(Route121_SafariZoneEntrance_Text_PleaseEnjoyYourself, MSGBOX_DEFAULT)
    closemessage
    hidemoneybox
    applymovement(LOCALID_PLAYER, moves(walk_left * 6,  walk_down,  delay_16))
    waitmovement(0)
    special(EnterSafariMode)
    setvar(VAR_SAFARI_ZONE_STATE, 2)
    clearflag(FLAG_GOOD_LUCK_SAFARI_ZONE)
    warp(MAP_SAFARI_ZONE_SOUTH, 32, 33)
    waitstate
    end
}

script Route121_SafariZoneEntrance_EventScript_MovePlayerBackFromCounter {
    closemessage
    hidemoneybox
    applymovement(LOCALID_PLAYER, Common_Movement_WalkRight)
    waitmovement(0)
    releaseall
    end
}

script Route121_SafariZoneEntrance_EventScript_TrainerTipSign {
    msgbox(Route121_SafariZoneEntrance_Text_TrainerTip, MSGBOX_SIGN)
    end
}

script Route121_SafariZoneEntrance_EventScript_AlreadyReceivedMoomooMilk {
    showmoneybox(0, 0)
    msgbox(Route121_SafariZoneEntrance_Text_WantToBuyMoomooMilk, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(Route121_SafariZoneEntrance_EventScript_BuyMoomooMilk)
    }
    msgbox(Route121_SafariZoneEntrance_Text_ThatsTooBad, MSGBOX_DEFAULT)
    hidemoneybox
    release_end
}

raw `
Route121_SafariZoneEntrance_EventScript_BuyMoomooMilk::
	checkmoney 1100
	goto_if_eq VAR_RESULT, FALSE, Route121_SafariZoneEntrance_EventScript_NoMoneyForMilk
	checkitemspace ITEM_MOOMOO_MILK
	goto_if_eq VAR_RESULT, FALSE, Route121_SafariZoneEntrance_EventScript_NotEnoughSpace
	msgbox Route121_SafariZoneEntrance_Text_HereYouGo, MSGBOX_DEFAULT
	removemoney 1100
	updatemoneybox
.if OW_SHOW_ITEM_DESCRIPTIONS != OW_ITEM_DESCRIPTIONS_OFF
	hidemoneybox
	giveitem ITEM_MOOMOO_MILK
.else
	giveitem ITEM_MOOMOO_MILK
	hidemoneybox
.endif
	release_end
`

script Route121_SafariZoneEntrance_EventScript_NoMoneyForMilk {
    msgbox(Route121_SafariZoneEntrance_Text_NoMoneyForMilk, MSGBOX_DEFAULT)
    hidemoneybox
    release_end
}

script Route121_SafariZoneEntrance_EventScript_NotEnoughSpace {
    msgbox(gText_TooBadBagIsFull, MSGBOX_DEFAULT)
    hidemoneybox
    release_end
}

text Route121_SafariZoneEntrance_Text_WantToBuyMoomooMilk {
	"Want to buy some MOOMOO MILK?
	POKéMON love it!

	Just ¥1100 a bottle!
	Buy some!"
}

text Route121_SafariZoneEntrance_Text_HereYouGo {
	"Here you go!"
}

text Route121_SafariZoneEntrance_Text_NoMoneyForMilk {
	"You don't have the money."
}

text Route121_SafariZoneEntrance_Text_ThatsTooBad {
	"No?
	That's too bad."
}
